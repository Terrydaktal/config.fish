[Unit]
Description=Ensure the CopyQ KWin window toggle is loaded
After=plasma-kwin_wayland.service
Wants=plasma-kwin_wayland.service
PartOf=plasma-kwin_wayland.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/home/lewis/Dev/config/bin/ensure-copyq-window-toggle
RemainAfterExit=yes
Restart=on-failure
RestartSec=1
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus

[Install]
WantedBy=plasma-workspace-wayland.target
